<?xml version="1.0" encoding="utf-8"?>
<com.example.tugashelloworld.util.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:foreground="?attr/selectableItemBackground">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceVariant"
        android:contentDescription="@string/cd_report_photo"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/overlay_selected"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#661E3A8A"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_play"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:contentDescription="@string/cd_play_video"
        android:src="@drawable/ic_play"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_pill_dark"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_unchecked"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_select_ring"
        android:contentDescription="@null"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@null"
        android:padding="3dp"
        android:src="@drawable/ic_check_brand"
        android:visibility="gone" />
</com.example.tugashelloworld.util.SquareFrameLayout>
