<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Pratinjau kamera langsung -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- Tinjau foto -->
    <ImageView
        android:id="@+id/iv_review"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_report_photo"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Tinjau video -->
    <VideoView
        android:id="@+id/vv_review"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Cincin fokus -->
    <View
        android:id="@+id/focus_ring"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_focus_ring"
        android:visibility="invisible" />

    <!-- Efek kilat saat memotret -->
    <View
        android:id="@+id/flash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/white"
        android:clickable="false"
        android:focusable="false" />

    <!-- Bar atas: tutup, zoom, blitz -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_icon_dark"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close" />

        <!-- Penghitung waktu saat merekam -->
        <LinearLayout
            android:id="@+id/layout_rec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <View
                android:id="@+id/view_rec_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="#EF4444" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_camera_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="1.0x"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/btn_flash"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_dark"
                android:contentDescription="@string/cd_flash"
                android:src="@drawable/ic_flash_auto" />
        </LinearLayout>
    </FrameLayout>

    <!-- Petunjuk mode (mis. efek potret) -->
    <TextView
        android:id="@+id/tv_mode_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_pill_dark"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Kontrol bawah: pilihan mode + rana + ganti kamera -->
    <LinearLayout
        android:id="@+id/camera_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/layout_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/tab_portrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:text="@string/mode_portrait"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:text="@string/mode_photo"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:text="@string/mode_video"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageButton
                android:id="@+id/btn_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter"
                android:contentDescription="@string/cd_shutter" />

            <!-- Thumbnail hasil terakhir: buka galeri -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btn_gallery_thumb"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="40dp"
                android:background="@drawable/bg_icon_dark"
                android:contentDescription="@string/cd_open_gallery"
                android:padding="1.5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_gallery"
                app:shapeAppearanceOverlay="@style/ShapeRounded12"
                app:strokeColor="@color/white"
                app:strokeWidth="1.5dp" />

            <ImageButton
                android:id="@+id/btn_switch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_icon_dark"
                android:contentDescription="@string/cd_switch_camera"
                android:src="@drawable/ic_flip_camera" />

            <!-- Foto saat merekam video: menempati posisi tombol ganti kamera -->
            <ImageButton
                android:id="@+id/btn_snapshot"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/cd_snapshot"
                android:src="@drawable/ic_camera"
                android:visibility="gone"
                app:tint="@color/black" />
        </FrameLayout>
    </LinearLayout>

    <!-- Kontrol mode tinjau: Ulangi / Gunakan -->
    <LinearLayout
        android:id="@+id/review_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retake"
            style="@style/Widget.LaporWarga.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/camera_retake"
            android:textColor="@color/white"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/white"
            app:strokeColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_use"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/camera_use" />
    </LinearLayout>
</FrameLayout>
