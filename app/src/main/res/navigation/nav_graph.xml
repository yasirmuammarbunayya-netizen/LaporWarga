<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tugashelloworld.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.tugashelloworld.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.tugashelloworld.ui.home.HomeFragment"
        android:label="Beranda"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_home_to_form"
            app:destination="@id/formFragment" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.tugashelloworld.ui.map.MapFragment"
        android:label="Peta"
        tools:layout="@layout/fragment_map">
        <action
            android:id="@+id/action_map_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/myReportsFragment"
        android:name="com.example.tugashelloworld.ui.myreports.MyReportsFragment"
        android:label="Laporan Saya"
        tools:layout="@layout/fragment_my_reports">
        <action
            android:id="@+id/action_myreports_to_detail"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_myreports_to_form"
            app:destination="@id/formFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.tugashelloworld.ui.profile.ProfileFragment"
        android:label="Profil"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.tugashelloworld.ui.detail.DetailFragment"
        android:label="Detail Laporan"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="reportId"
            app:argType="long" />
        <action
            android:id="@+id/action_detail_to_form"
            app:destination="@id/formFragment" />
    </fragment>

    <fragment
        android:id="@+id/formFragment"
        android:name="com.example.tugashelloworld.ui.form.FormFragment"
        android:label="Form Laporan"
        tools:layout="@layout/fragment_form">
        <argument
            android:name="reportId"
            android:defaultValue="0L"
            app:argType="long" />
        <action
            android:id="@+id/action_form_to_camera"
            app:destination="@id/cameraFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.example.tugashelloworld.ui.camera.CameraFragment"
        android:label="Kamera"
        tools:layout="@layout/fragment_camera" />
</navigation>
